    "groq:check": "node --env-file=.env.local scripts/check-groq-live.mjs",
    "styles:landing": "npx --yes --package=tailwindcss@3.4.17 tailwindcss -c styles/landing.tailwind.cjs -i styles/landing.input.css -o app/new-landing.css --minify"
