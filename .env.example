# Required for the shared workspace. Leave both blank for the local UI preview.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Enable sample accounts in a synthetic Supabase project only.
KINETRIA_DEMO_PASSWORD=
# Used only by the account provisioning script.
SUPABASE_SECRET_KEY=

# Optional server-only OpenAI key for drafting requests.
# Select openai or gemini. Only the selected provider's key is used.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional public contact address for pilot enquiries.
KINETRIA_CONTACT_EMAIL=
