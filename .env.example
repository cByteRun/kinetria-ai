# Required for the shared workspace. Leave both blank for the local UI preview.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Enable sample accounts in a synthetic Supabase project only.
KINETRIA_DEMO_PASSWORD=
# Used by account provisioning, the server-only Telegram bridge and impact enrichment.
SUPABASE_SECRET_KEY=

# Optional AI. Vercel allows the explicitly selected Groq provider.
# Select groq, ollama, openai or gemini. Leave blank to disable.
AI_PROVIDER=
OLLAMA_MODEL=qwen2.5:3b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional public contact address for pilot enquiries.
KINETRIA_CONTACT_EMAIL=

# Public website origin for Telegram → /login. Set your HTTPS domain after deployment.
APP_URL=

# Telegram webhook (server only). Deploy Next.js, then run pnpm telegram:webhook.
# Bot must be an admin of a PRIVATE channel.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_CHANNEL_ID=
# Same random 20–256 character secret in Vercel and setup environment.
TELEGRAM_WEBHOOK_SECRET=
# External scheduler/retry endpoint: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
# Groq speech + optional text draft. Set AI_PROVIDER=groq to enable text on Vercel.
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
GROQ_TEXT_MODEL=qwen/qwen3.8-27b
# Explicit demo-only role switching. Keep disabled in production.
TELEGRAM_DEMO_ENABLED=false
TELEGRAM_DEMO_ALLOWED_IDS=

# Optional isolated local PostgreSQL test tools; never use hosted production credentials.
PGUSER=
PGPASSWORD=
# Explicit guard for one-off hosted migration scripts.
MIGRATION_PROJECT_REF=
