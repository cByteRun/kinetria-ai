# Required for the shared workspace. Leave both blank for the local UI preview.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Enable sample accounts in a synthetic Supabase project only.
KINETRIA_DEMO_PASSWORD=
# Used only by the account provisioning script.
SUPABASE_SECRET_KEY=

# Optional AI for local runs. On Vercel it is disabled.
# Select ollama, openai or gemini. Leave blank to disable.
AI_PROVIDER=
OLLAMA_MODEL=qwen2.5:3b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional public contact address for pilot enquiries.
KINETRIA_CONTACT_EMAIL=
